<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="stylesheet" href="{{asset('bootstrap/css/bootstrap.min.css')}}">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
        <link href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" rel="stylesheet" />
        <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>
        <link rel="stylesheet" href="{{asset("css/style.css")}}">
        <link rel="stylesheet" href="{{asset("css/book_meeting_style.css")}}">

        {% block styles %} {% endblock %}
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>

    <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container-fluid">
    <a class="navbar-brand" href="{{ path('app_home') }}">
      <img src="{{asset("imgs/logo.png")}}" alt="logo" width="175" >
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item" id="p_">
          <a class="nav-link" aria-current="page" href="{{ path('app_home') }}">Home</a>
        </li>
        
        <li class="nav-item" id="p_meeting">
          <a class="nav-link" href="{{ path('app_meeting') }}">Meetings</a>
        </li>
        <li class="nav-item" id="p_books">
            <a class="nav-link" href="{{ path('app_books', {'off': 1}) }}">Books</a>
        </li>
        <li class="nav-item" id="p_profile">
          <a class="nav-link" href="{{ path('app_profile') }}">Profile</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="{{ path(app.user ? 'app_logout' : 'app_login') }}">{{ app.user ? 'Logout' : 'Login' }}</a>

        </li>
      </ul>
        <form action="{{ path('app_search_results') }}" class="d-flex" method="post">
            <input name="input" class="form-control me-2" type="search" placeholder="Search books" aria-label="Search">
            <button class="btn btn-outline-success" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
    </div>
  </div>
    </nav>
    </body>
    {% block body %}{% endblock %}

    <script src="{{asset("bootstrap/js/bootstrap.min.js")}}"></script>

    <script defer>
          const path = window.location.pathname
          let redirector = "p_" + path.split('/')[2]
          console.log(redirector)
          document.querySelector("#"+redirector).classList.add("active")


    </script>

    {% block scripts %}{% endblock %}

</html>



