{% extends "base.html.twig" %}
{% block title %}
    BookBinder | HomePage
{% endblock %}
{% block styles %}
<link href="{{asset("own-carousel/own-carousel.min.css")}}" rel="stylesheet">

{% endblock %}
{% block body %}

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-3">
                {% include "Components/Home/left_side_info.html.twig" with {name:name,image:userimage, bio:bio, email:email} %}
             
            </div>
            <div class="col-md-6">
                <div class="row">
                   <div class="col-md-12">
                        {% include "Components/Home/trending_section.html.twig" with {trendings:trendingBooks} %}

                   </div>
                </div>

                 <div class="row mt-3">
                   <div class="col-md-12">
                        {% include "Components/Home/newest_section.html.twig" with {"section_title":"Newest Books","col_num":4, newestBooks:newestBooks} %}

                   </div>
                </div>
            </div>
            <div class="col-md-3">
            <div class="row">
                        {% include "Components/Home/event_section.html.twig" %}

            </div>
            <div class="row" style="margin-top:23rem;">
                        {% include "Components/Home/tiktok_section.html.twig" %}

            </div>
            </div>
        </div>
    </div>
        {% include "Components/MeetingModal.html.twig" with {allbooks:allBooks,allLibraries:allLibraries} %}

{% endblock %}

{% block scripts %} 
<script src="{{asset("own-carousel/own-carousel.min.js")}}"></script>

{% endblock %}

